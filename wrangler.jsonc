{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vault-crafted-crafted",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Gestionale ordini: database D1 "vault-ordini" e archivio R2 "vault-ordini" (foto, illustrazioni).
  "d1_databases": [
    { "binding": "DB", "database_name": "vault-ordini", "database_id": "0246ada1-0e40-46de-a1d1-7918364a3958", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "vault-ordini" }],
  "vars": {
    "SITE_URL": "https://vaultcrafted.com",
    "MAIL_FROM": "ordini@vaultcrafted.com",
    "MAIL_FROM_NAME": "Vault Crafted",
    "MAIL_ADMIN": "vaultcrafted@gmail.com"
  }
  // Segreti da impostare su Cloudflare (non vanno nel codice):
  //   ADMIN_PASSWORD  → password del pannello /admin
  //   BREVO_API_KEY   → chiave API di Brevo per le email
}
